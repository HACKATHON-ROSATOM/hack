# Copy this file to .env. Never commit .env or real secrets.
# Application port for local Node.js; Compose uses port 3000 inside the container.
# Decimal integer 0..65535; 0 allows an automatic local port.
PORT=3000

# Published port on your computer for Docker Compose only.
# Change HOST_PORT if 3000 is already occupied; keep PORT unchanged.
HOST_PORT=3000

# Published interface port for Docker Compose only.
FRONTEND_HOST_PORT=3002

# Express mode: development, test, or production. Empty values are invalid.
NODE_ENV=development

# Debug namespaces. Use DEBUG= to disable server debug messages.
DEBUG=express-app:server

# Local development only. These public example credentials are not production secrets.
# Start PostgreSQL with: docker compose up --detach --wait db
DATABASE_URL=postgresql://express:express@127.0.0.1:5432/express_app

# Compose publishes PostgreSQL on loopback only. Change if 5432 is occupied.
POSTGRES_HOST_PORT=5432
