generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

model Note {
  id        String   @id @default(uuid()) @db.Uuid
  content   String
  createdAt DateTime @default(now())
}

enum EquipmentType {
  GENERATOR
  CONVERTER
  LUBRICATION_SYSTEM
  CONTROLLER
  TRANSFORMER
}

model Equipment {
  id                  String              @id @default(uuid()) @db.Uuid
  externalId          String?
  externalIdType      String?
  externalIdKey       String              @unique
  name                String
  type                EquipmentType
  hierarchyLevel0     String?
  hierarchyLevel1     String?
  hierarchyLevel2     String?
  hierarchyLevel3     String?
  hierarchyLevel4     String?
  hierarchyLevel5     String?
  hierarchyLevel6     String?
  typicalRepairObject String?
  commissionedOn      DateTime?           @db.Date
  manufacturedOn      DateTime?           @db.Date
  workSchedule        String?
  usefulLifeMonths    Int?
  inventoryNumber     String?
  comment             String?
  history             MaintenanceRecord[]
  tickets             Ticket[]
}

model MaintenanceRecord {
  id                    String     @id @default(uuid()) @db.Uuid
  importRowId           String     @unique
  externalEquipmentId   String
  equipmentId           String?    @db.Uuid
  equipment             Equipment? @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  workType              String?
  statusAtImport        String?
  downtimeReason        String?
  completedOn           DateTime?  @db.Date
  operatingMetric       String?
  operatingUnit         String?
  plannedOperatingValue Decimal?
  plannedPeriod         String?
  periodDuration        Decimal?
  workFrom              DateTime?  @db.Date
  workTo                DateTime?  @db.Date
  operatingValue        Decimal?
  controlledIndicator   String?
  indicatorUnit         String?
  controlledOn          DateTime?  @db.Date
  indicatorValue        String?
  rawData               Json
  sourceSheet           String
  sourceRow             Int

  @@index([equipmentId])
}

enum UserRole {
  DUTY
  ENGINEER
  DIRECTOR
}

model User {
  id              String           @id @db.Uuid
  login           String           @unique
  passwordHash    String
  fullName        String
  role            UserRole
  createdAt       DateTime         @default(now()) @db.Timestamptz
  createdTickets  Ticket[]         @relation("TicketAuthor")
  assignedTickets Ticket[]         @relation("TicketAssignee")
  auditLogs       TicketAuditLog[]
}

enum TicketType {
  INSPECTION
  REPAIR
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  WAITING_PARTS
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditAction {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  DEADLINE_CHANGED
  PRIORITY_CHANGED
  TYPE_CHANGED
  COMMENT_ADDED
}

model Ticket {
  id                String           @id @default(uuid()) @db.Uuid
  ticketNumber      Int              @default(autoincrement())
  version           Int              @default(1)
  type              TicketType
  status            TicketStatus     @default(NEW)
  priority          Priority         @default(MEDIUM)
  equipmentId       String           @db.Uuid
  equipment         Equipment        @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  authorId          String           @db.Uuid
  author            User             @relation("TicketAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  assigneeId        String?          @db.Uuid
  assignee          User?            @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  description       String
  initialDeadline   DateTime         @db.Timestamptz
  currentDeadline   DateTime         @db.Timestamptz
  completionComment String?
  createdAt         DateTime         @default(now()) @db.Timestamptz
  updatedAt         DateTime         @updatedAt @db.Timestamptz
  completedAt       DateTime?        @db.Timestamptz
  auditLogs         TicketAuditLog[]

  @@index([equipmentId])
  @@index([assigneeId])
  @@index([status])
}

model TicketAuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  ticketId  String      @db.Uuid
  ticket    Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String      @db.Uuid
  author    User        @relation(fields: [authorId], references: [id], onDelete: Restrict)
  action    AuditAction
  fieldName String?
  oldValue  String?
  newValue  String?
  comment   String?
  createdAt DateTime    @default(now()) @db.Timestamptz

  @@index([ticketId])
}
